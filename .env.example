ENVIRONMENT=development
PROJECT_NAME="Secure AI Assistant for Legal Data Analysis"
BACKEND_PORT=8000
FRONTEND_PORT=5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# See backend/.env.example for the complete backend configuration including:
# JWT_SECRET_KEY, GEMINI_API_KEY, GEMINI_ENCRYPTION_KEY, DATABASE_URL, etc.
