# ─────────────────────────────────────────────────────────────────
# LexGuard AI — .gitignore
# ─────────────────────────────────────────────────────────────────

# ── Secrets & Environment ──────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key

# ── Python ────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
pip-wheel-metadata/
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/

# ── Database & User Data ──────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
data/documents/
data/vector_store/
data/verifications/
data/cases/
!data/README.md

# ── Node / Frontend ───────────────────────────────────────────────
node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.local
.cache/

# ── Uploads & Generated Files ─────────────────────────────────────
uploads/
backend/uploads/
backend/data/documents/
backend/data/verifications/
backend/data/vector_store/

# ── Models & Large Files ──────────────────────────────────────────
models/
*.faiss
*.pkl
*.pt
*.safetensors
*.bin

# ── Logs ──────────────────────────────────────────────────────────
*.log
logs/

# ── IDE & OS ──────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
Desktop.ini

# ── Temp ──────────────────────────────────────────────────────────
*.tmp
*.temp
*.swp
*.swo
test_temp.db
