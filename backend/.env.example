# =============================================================================
# LexGuard AI — Environment Configuration Template
# Copy this file to .env and fill in all values before running.
# NEVER commit .env to version control.
# =============================================================================

# ── Application ───────────────────────────────────────────────────────────────
PROJECT_NAME="Secure AI Assistant for Legal Data Analysis"
VERSION="0.1.0"
API_V1_STR="/api/v1"

# "development" | "production"
ENVIRONMENT="development"

HOST="127.0.0.1"
PORT=8000

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Do NOT use * in production.
# Example: http://localhost:5173,https://yourdomain.com
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="sqlite:///./data/secure_legal.db"

# ── JWT Authentication ────────────────────────────────────────────────────────
# REQUIRED: Generate a strong secret with:
#   python -c "import secrets; print(secrets.token_hex(48))"
# NEVER use a guessable or short value here.
JWT_SECRET_KEY="REPLACE_WITH_STRONG_RANDOM_SECRET"

ALGORITHM="HS256"

# Token lifetime in minutes.
# Recommended: 30 for production, up to 1440 (24h) for dev convenience.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Session revocation — set false only for load testing
REVOCATION_ENABLED=true

# ── Google Gemini API ─────────────────────────────────────────────────────────
# Leave empty to use the built-in Free AI Legal Engine fallback.
# Obtain a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""
GEMINI_MODEL_NAME="gemini-2.0-flash"

# ── Gemini API-Key Encryption ─────────────────────────────────────────────────
# REQUIRED for production: generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave empty in development to use the JWT_SECRET_KEY derivation fallback.
# NEVER commit the real value.
GEMINI_ENCRYPTION_KEY=""

# ── RAG Pipeline ─────────────────────────────────────────────────────────────
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.35
RAG_MAX_CONTEXT_CHUNKS=5

# ── Chat History ─────────────────────────────────────────────────────────────
CHAT_MAX_HISTORY_MESSAGES=20
CHAT_MAX_HISTORY_CHARS=8000

# ── File Upload Limits ────────────────────────────────────────────────────────
# Enforced in documents.py and verification.py
MAX_DOCUMENT_SIZE_MB=10
MAX_VERIFICATION_SIZE_MB=10

# ── Rate Limiting ─────────────────────────────────────────────────────────────
# Set RATE_LIMIT_ENABLED=false to disable all rate limits (e.g. during testing).
RATE_LIMIT_ENABLED=true

# Per-endpoint limits — format: "<count>/<window>" (minute | hour | day)
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_REGISTER=10/minute
RATE_LIMIT_PUBLIC_QUERY=20/minute
RATE_LIMIT_RAG_QUERY=10/minute
RATE_LIMIT_DOC_UPLOAD=5/minute
RATE_LIMIT_DOC_ANALYSIS=5/minute
RATE_LIMIT_CHAT_MESSAGE=20/minute
RATE_LIMIT_CHAT_CREATE=20/minute
